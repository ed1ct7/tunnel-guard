{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunnel Guard",
  "version": "0.6.0-preview.4",
  "identifier": "local.tunnelguard.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Tunnel Guard", "width": 900, "height": 620, "minWidth": 730, "minHeight": 540, "center": true }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
